# MySQL obituary table (the existing `obits` schema is retained)
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=obituary
DATABASE_ADDRESS=127.0.0.1
DATABASE_PORT=3306

# Optional funeral home XML feeds. Site still searches MySQL if these are blank.
PIERCE_FUNERAL_HOME=
FAIRVIEW_FUNERAL_HOME=

# Optional when requesting the backend directly from browsers; not needed with Next proxy.
FRONTEND_ORIGIN=http://localhost:3000
PORT=3001
# Set true only when behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
